{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Psy-Analysis Delivery Manifest",
  "description": "交付包 manifest.json 的期望结构",
  "type": "object",
  "required": ["project_id", "title", "mode", "created_at", "file_count", "files"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "mode": {"type": "string", "enum": ["basic", "standard", "full"]},
    "created_at": {"type": "string"},
    "file_count": {"type": "integer", "minimum": 1},
    "pdf_status": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": {"type": "string"},
          "type": {"type": "string"},
          "format": {"type": "string"}
        }
      }
    }
  }
}
