# psy-analysis 环境变量模板（s919-08 新建；变量集合与 README「环境变量示例」一节逐字对齐）
#
# 用法：复制为 `.env.local` 并填值。注意 LLM 三件套的实际读取点不是本仓根——
#   src/llm_gateway/quick_models.py:_candidate_env_paths() 从本文件所在目录逐级向上找**首个** `.env.local`，
#   因此默认命中的是 **D:/code/.env.local**（根工作区那份）；本仓根的 `.env.local` 只在根那份不存在时才被读到。
# 前缀必须与 quick_models.py 的 QUICK_MODELS[].env_prefix 对齐：GPT / DEEPSEEK / KIMI / CLAUDE（各组三件套）。
# ⚠ 切勿把真实 key 写进本文件或提交进仓——本仓 .gitignore 目前**没有** `.env*` 条目（已登记为遗留）。

# ── LLM：DeepSeek 组（其余三组同构：GPT_* / KIMI_* / CLAUDE_*）────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 持久化路径重定向（实读于 src/utils/app_paths.py；留空＝用默认值）──────────
# 用户数据根，默认 ~/.psy_analysis；派生 projects/ 与 user_prefs.json、autosave.json、autosave_meta.json
PSY_ANALYSIS_HOME=
# 归档根，默认落在仓库内 archive/；便携部署时可指到仓外（示例：D:/psy-data/archive）
PSY_ANALYSIS_ARCHIVE_DIR=
# 运行日志目录，默认是「相对当前工作目录」的 logs/ —— 换 cwd 就会换位置，自动化/夜桥执行请写绝对路径
PSY_ANALYSIS_LOG_DIR=
